<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.mobiletracker.accessibilitymanifest">
    <application>
        <service
            android:name="org.mobiletracker.mobiletracker.RestrictionAccessibilityService"
            android:label="Mobile Tracker app blocking"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mobile_tracker_accessibility_service" />
        </service>
    </application>
</manifest>
